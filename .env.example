# Copy to .env and fill in. NEVER commit a filled .env (it is gitignored).
# Without these two values the app runs in DEMO MODE (simulated checkout, labeled).

# From developer.paypal.com → Apps & Credentials → (Sandbox) → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# sandbox | live
PAYPAL_ENV=sandbox
# Sandbox API base. Live is https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Server port
PORT=8080

# Optional: KHAAN.SI answer pipeline used for live preview sampling
KHAAN_ASK_URL=https://khaan.si/api/ask
PREVIEW_TIMEOUT_MS=45000
